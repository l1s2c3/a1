[
  {"id": "v1",  "chapter": "SEG001", "cue": 0.5,  "text": "你为得到某样东西，吃过多少苦"},
  {"id": "v2",  "chapter": "SEG001", "cue": 3.5,  "text": "回想一下，那段最难熬的时候"},
  {"id": "v3",  "chapter": "SEG001", "cue": 7.5,  "text": "付出的痛苦越多，越容易高估它的价值"},
  {"id": "v4",  "chapter": "SEG001", "cue": 11.5, "text": "哪怕它其实很普通"},
  {"id": "v5",  "chapter": "SEG002", "cue": 15.5, "text": "大脑不想承认，换来的东西不值"},
  {"id": "v6",  "chapter": "SEG002", "cue": 19.5, "text": "这种自我怀疑，让人很难受"},
  {"id": "v7",  "chapter": "SEG002", "cue": 24.0, "text": "大脑主动抬高目标的价值"},
  {"id": "v8",  "chapter": "SEG002", "cue": 28.0, "text": "把痛苦合理化"},
  {"id": "v9",  "chapter": "SEG003", "cue": 30.5, "text": "一九五九年，一个经典实验"},
  {"id": "v10", "chapter": "SEG003", "cue": 34.5, "text": "一组轻松进入，一组要先通过难堪的测试"},
  {"id": "v11", "chapter": "SEG003", "cue": 40.0, "text": "结果，难堪的那组评价反而更高"},
  {"id": "v12", "chapter": "SEG004", "cue": 45.3, "text": "艰难不等于有价值"},
  {"id": "v13", "chapter": "SEG004", "cue": 49.2, "text": "把付出和价值分开算"}
]
